# ------------------------------------------------
# 1. 가상환경 및 설정 (반드시 제외)
# ------------------------------------------------
# Conda 로컬 환경 폴더
.conda/
env/
envs/
condaenv.*.requirements.txt

# Python venv 환경 폴더
venv/
.venv/
.env

# ------------------------------------------------
# 2. Python 자동 생성 파일
# ------------------------------------------------
__pycache__/
*.py[cod]
*$py.class

# ------------------------------------------------
# 3. 데이터 및 결과물 (용량 큼 -> 제외)
# ------------------------------------------------
# 시뮬레이션 및 3D 데이터
*.vdb
*.obj
*.ply
*.stl
*.bgeo

# Numpy 데이터 및 학습 체크포인트
*.npy
*.npz
*.pt
*.pth
*.ckpt

# 결과물 저장 폴더를 통째로 무시하고 싶다면:
output/
data/
checkpoints/

# ------------------------------------------------
# 4. IDE 및 OS 설정 파일
# ------------------------------------------------
# VS Code 설정 (개인 경로 등이 포함될 수 있음)
.vscode/

# Jupyter Notebook 체크포인트
.ipynb_checkpoints/

# OS 잡동사니
.DS_Store
Thumbs.db